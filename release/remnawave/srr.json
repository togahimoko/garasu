{
  "version": "1",
  "rules": [
    {
      "name": "Browser Subscription",
      "description": "System critical: do not delete or disable this rule.",
      "enabled": true,
      "operator": "AND",
      "conditions": [
        {
          "headerName": "accept",
          "operator": "CONTAINS",
          "value": "text/html",
          "caseSensitive": true
        }
      ],
      "responseType": "BROWSER"
    },
    {
      "name": "Mihomo Clients",
      "description": "Garasu native Mihomo YAML with personal VLESS/REALITY nodes and MRS rule assets",
      "enabled": true,
      "operator": "AND",
      "conditions": [
        {
          "headerName": "user-agent",
          "operator": "REGEX",
          "value": "^(?:flclash|rabbit|flowvy|murge|mihomo|prizrak-box|koala-clash|clash(?:[- /]verge(?:[- ]rev)?|[- /]nyanpasu|x meta|[-.]?meta))",
          "caseSensitive": false
        }
      ],
      "responseType": "MIHOMO",
      "responseModifications": {
        "subscriptionTemplate": "Default"
      }
    },
    {
      "name": "Stash (iOS, macOS)",
      "description": "Response with generated YAML config (Stash Template)",
      "enabled": true,
      "operator": "AND",
      "conditions": [
        {
          "headerName": "user-agent",
          "operator": "REGEX",
          "value": "^stash",
          "caseSensitive": false
        }
      ],
      "responseType": "STASH",
      "responseModifications": {
        "subscriptionTemplate": "Default"
      }
    },
    {
      "name": "Sing-box clients",
      "description": "Response with generated JSON config (Singbox template)",
      "enabled": true,
      "operator": "AND",
      "conditions": [
        {
          "headerName": "user-agent",
          "operator": "REGEX",
          "value": "^(?:sfa|sfi|sfm|sft|karing|singbox)",
          "caseSensitive": false
        }
      ],
      "responseType": "SINGBOX",
      "responseModifications": {
        "subscriptionTemplate": "Default"
      }
    },
    {
      "name": "Clash Core Clients",
      "description": "Classic Clash/Premium native YAML: one automatic Garasu group and 10 remote YAML providers",
      "enabled": true,
      "operator": "AND",
      "conditions": [
        {
          "headerName": "user-agent",
          "operator": "REGEX",
          "value": "^clash(?:/|$|x(?:/|$)|-premium(?:/|$)|[- ]for[- ]windows(?:/|$))",
          "caseSensitive": false
        }
      ],
      "responseType": "CLASH",
      "responseModifications": {
        "subscriptionTemplate": "Default"
      }
    },
    {
      "name": "INCY Garasu",
      "description": "Base64 personal nodes and auto-updating native Garasu routing",
      "enabled": true,
      "operator": "AND",
      "conditions": [
        {
          "headerName": "user-agent",
          "operator": "STARTS_WITH",
          "value": "incy/",
          "caseSensitive": false
        }
      ],
      "responseType": "XRAY_BASE64",
      "responseModifications": {
        "headers": [
          {
            "key": "autorouting",
            "value": "incy://autorouting/onadd/https://raw.githubusercontent.com/togahimoko/garasu/main/release/incy/config.json"
          }
        ],
        "applyHeadersToEnd": true,
        "ignoreServeJsonAtBaseSubscription": true
      }
    },
    {
      "name": "Happ Garasu",
      "description": "Base64 personal nodes and embedded native Garasu routing",
      "enabled": true,
      "operator": "AND",
      "conditions": [
        {
          "headerName": "user-agent",
          "operator": "STARTS_WITH",
          "value": "happ",
          "caseSensitive": false
        }
      ],
      "responseType": "XRAY_BASE64",
      "responseModifications": {
        "headers": [
          {
            "key": "routing",
            "value": "happ:"
          }
        ],
        "applyHeadersToEnd": true,
        "ignoreServeJsonAtBaseSubscription": true
      }
    },
    {
      "name": "Xray JSON clients (opt-in)",
      "description": "Explicit native Xray JSON requests use Default Xray template; other Xray apps retain Base64",
      "enabled": true,
      "operator": "AND",
      "conditions": [
        {
          "headerName": "user-agent",
          "operator": "REGEX",
          "value": "^(?:garasu-xray-json|xray(?:-core)?)(?:/|$)",
          "caseSensitive": false
        }
      ],
      "responseType": "XRAY_JSON",
      "responseModifications": {
        "subscriptionTemplate": "Default",
        "ignoreHostXrayJsonTemplate": true
      }
    },
    {
      "name": "Shadowrocket Garasu",
      "description": "Personal XRAY_BASE64 nodes; managed Garasu rule profile is imported separately",
      "enabled": true,
      "operator": "AND",
      "conditions": [
        {
          "headerName": "user-agent",
          "operator": "STARTS_WITH",
          "value": "shadowrocket",
          "caseSensitive": false
        }
      ],
      "responseType": "XRAY_BASE64",
      "responseModifications": {
        "ignoreServeJsonAtBaseSubscription": true
      }
    },
    {
      "name": "Fallback Base64",
      "description": "System critical: do not delete or disable this rule.",
      "enabled": true,
      "operator": "AND",
      "conditions": [],
      "responseType": "XRAY_BASE64"
    }
  ],
  "settings": {
    "disableSubscriptionAccessByPath": false
  }
}
