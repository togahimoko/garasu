{
  "dns": {
    "rules": [
      {
        "domain_suffix": [
          "localhost",
          "local",
          "lan",
          "home.arpa"
        ],
        "action": "route",
        "server": "local"
      },
      {
        "server": "remote",
        "query_type": [
          "A",
          "AAAA"
        ]
      }
    ],
    "servers": [
      {
        "tag": "cf-dns",
        "type": "tls",
        "server": "1.1.1.1"
      },
      {
        "tag": "local",
        "type": "local"
      },
      {
        "tag": "remote",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "independent_cache": true
  },
  "log": {
    "level": "warn",
    "disabled": false,
    "timestamp": true
  },
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "domain_suffix": [
          "localhost",
          "local",
          "lan",
          "home.arpa"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "garasu-rkn-domains-full",
          "garasu-rkn-ips-full",
          "garasu-youtube",
          "garasu-discord",
          "garasu-ai",
          "garasu-crypto",
          "garasu-proxy",
          "garasu-proxy-ips"
        ],
        "action": "route",
        "outbound": "→ Remnawave"
      },
      {
        "rule_set": [
          "garasu-ads"
        ],
        "action": "reject",
        "method": "default"
      }
    ],
    "auto_detect_interface": true,
    "default_domain_resolver": "local",
    "rule_set": [
      {
        "type": "remote",
        "tag": "garasu-rkn-domains-full",
        "format": "source",
        "update_interval": "6h",
        "http_client": "garasu-rules",
        "url": "https://raw.githubusercontent.com/togahimoko/garasu/feature/unified-routing-astra-2026-11-03/rules/unified/refilter-domain-full.singbox.json"
      },
      {
        "type": "remote",
        "tag": "garasu-rkn-ips-full",
        "format": "source",
        "update_interval": "6h",
        "http_client": "garasu-rules",
        "url": "https://raw.githubusercontent.com/togahimoko/garasu/feature/unified-routing-astra-2026-11-03/rules/unified/refilter-ip-full.singbox.json"
      },
      {
        "type": "remote",
        "tag": "garasu-youtube",
        "format": "source",
        "url": "https://raw.githubusercontent.com/togahimoko/garasu/main/rules/singbox/youtube.json",
        "update_interval": "6h",
        "http_client": "garasu-rules"
      },
      {
        "type": "remote",
        "tag": "garasu-discord",
        "format": "source",
        "url": "https://raw.githubusercontent.com/togahimoko/garasu/main/rules/singbox/discord.json",
        "update_interval": "6h",
        "http_client": "garasu-rules"
      },
      {
        "type": "remote",
        "tag": "garasu-ai",
        "format": "source",
        "url": "https://raw.githubusercontent.com/togahimoko/garasu/main/rules/singbox/ai.json",
        "update_interval": "6h",
        "http_client": "garasu-rules"
      },
      {
        "type": "remote",
        "tag": "garasu-crypto",
        "format": "source",
        "url": "https://raw.githubusercontent.com/togahimoko/garasu/main/rules/singbox/crypto.json",
        "update_interval": "6h",
        "http_client": "garasu-rules"
      },
      {
        "type": "remote",
        "tag": "garasu-proxy",
        "format": "source",
        "url": "https://raw.githubusercontent.com/togahimoko/garasu/main/rules/singbox/proxy.json",
        "update_interval": "6h",
        "http_client": "garasu-rules"
      },
      {
        "type": "remote",
        "tag": "garasu-proxy-ips",
        "format": "source",
        "url": "https://raw.githubusercontent.com/togahimoko/garasu/main/rules/singbox/proxy-ips.json",
        "update_interval": "6h",
        "http_client": "garasu-rules"
      },
      {
        "type": "remote",
        "tag": "garasu-ads",
        "format": "source",
        "url": "https://raw.githubusercontent.com/togahimoko/garasu/main/rules/singbox/ads.json",
        "update_interval": "6h",
        "http_client": "garasu-rules"
      }
    ],
    "final": "→ Remnawave",
    "default_http_client": "garasu-rules"
  },
  "inbounds": [
    {
      "mtu": 9000,
      "tag": "tun-in",
      "type": "tun",
      "stack": "mixed",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "platform": {
        "http_proxy": {
          "server": "127.0.0.1",
          "enabled": true,
          "server_port": 2412
        }
      },
      "auto_route": true,
      "strict_route": true,
      "interface_name": "tun125",
      "endpoint_independent_nat": true
    },
    {
      "tag": "mixed-in",
      "type": "mixed",
      "users": [],
      "listen": "127.0.0.1",
      "listen_port": 2412,
      "set_system_proxy": false
    }
  ],
  "outbounds": [
    {
      "tag": "→ Remnawave",
      "type": "selector",
      "outbounds": null,
      "interrupt_exist_connections": true
    },
    {
      "tag": "direct",
      "type": "direct"
    }
  ],
  "experimental": {
    "clash_api": {
      "external_ui": "yacd",
      "default_mode": "rule",
      "external_controller": "127.0.0.1:9090",
      "external_ui_download_url": "https://github.com/MetaCubeX/Yacd-meta/archive/gh-pages.zip",
      "external_ui_download_detour": "direct"
    },
    "cache_file": {
      "path": "remnawave.db",
      "enabled": true,
      "cache_id": "remnawave",
      "store_fakeip": true
    }
  },
  "http_clients": [
    {
      "tag": "garasu-rules",
      "detour": "→ Remnawave"
    }
  ]
}
